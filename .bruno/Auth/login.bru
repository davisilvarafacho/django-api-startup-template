meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/login/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "demo@example.com",
    "password": "demo123456",
    "device_name": "bruno"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}
