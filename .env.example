# =====================================================================
# Arquivo de exemplo de variáveis de ambiente.
# Copie para `.env` (não versionado) e preencha os valores.
#   cp .env.example .env
# =====================================================================

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# development | production | test
DJANGO_ENVIRONMENT=development
DJANGO_EXECUTION_MODE=
DJANGO_LOG_LEVEL=INFO

# Hosts e origens confiáveis (listas separadas por vírgula)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Banco de dados (PostgreSQL) ---
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Celery (opcional: por padrão deriva do Redis acima) ---
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- E-mail (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Backblaze B2 (storage) ---
BACKBLAZE_APPLICATION_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=
BACKBLAZE_BUCKET_ID=
BACKBLAZE_LOCATION=
BACKBLAZE_PUBLIC_BASE_URL=

# --- Sentry ---
SENTRY_DSN=

# --- IP API ---
IPAPI_ACCESS_KEY=
